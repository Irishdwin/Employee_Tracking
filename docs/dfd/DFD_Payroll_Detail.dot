P9 -> D8 [label="DTR review decisions"];
D3 -> P9 [label="Employee salary configuration"];
D7 -> P9 [label="Effective shifts and holiday\nrules"];
D9 -> P9 [label="Approved overtime and existing\nleave"];
D13 -> P9 [label="Government deduction rate\nconfiguration"];
D10 -> P9 [label="Payroll runs, billing snapshots\nand adjustments"];
